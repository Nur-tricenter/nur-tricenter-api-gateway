<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ApiGateway.App</RootNamespace>
    <AssemblyName>ApiGateway.App</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>nur-tricenter-api-gateway-local-overrides</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <!--
      NU1510: "Microsoft.Extensions.Diagnostics.HealthChecks is redundant". True - it ships
      inside the Microsoft.AspNetCore.App shared framework, so the explicit reference never
      contributes an assembly at runtime. It is kept anyway so the dependency list stays
      explicit and readable next to the HealthChecks UI packages it belongs with. The warning is
      silenced here (and ONLY here) so `dotnet build` stays a clean signal.
    -->
    <NoWarn>$(NoWarn);NU1510</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Consul service discovery. The gateway queries the catalog + health endpoints
         on a timer and turns whatever is healthy into YARP routes. -->
    <PackageReference Include="Consul" Version="1.7.14.7" />
    <!-- Reverse proxy runtime + configuration abstractions (IProxyConfigProvider). -->
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
    <!-- Health endpoint plumbing + the Health Checks UI dashboard at /health-ui. -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="9.0.0" />
    <PackageReference Include="AspNetCore.HealthChecks.UI" Version="9.0.0" />
    <PackageReference Include="AspNetCore.HealthChecks.UI.Client" Version="9.0.0" />
    <PackageReference Include="AspNetCore.HealthChecks.UI.InMemory.Storage" Version="9.0.0" />
    <!--
      Pin: AspNetCore.HealthChecks.UI 9.0.0 depends on KubernetesClient 15.0.1, which
      carries advisory GHSA-w7r3-mgwf-4mqq / CVE-2025-9708 (NU1902, improper certificate
      validation) and is patched only from 17.0.14. We never touch a Kubernetes API - the
      package is only referenced by the UI's Kubernetes storage provider, which we do not
      register - so moving to 17.0.14 clears the advisory with no behavioural risk.
      Do NOT remove this pin unless AspNetCore.HealthChecks.UI stops requesting a
      KubernetesClient below 17.0.14.
    -->
    <PackageReference Include="KubernetesClient" Version="17.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the test project call the internal RefreshAsync() entry point so a refresh can
         be driven deterministically instead of racing the 30 second timer. -->
    <InternalsVisibleTo Include="ApiGateway.App.Tests" />
  </ItemGroup>

</Project>