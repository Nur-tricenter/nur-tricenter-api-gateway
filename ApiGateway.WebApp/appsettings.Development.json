{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "ServiceRegistration": {
    "ServiceDiscoveryAddress": "http://localhost:8500"
  },
  "HealthChecksUI": {
    "SelfHealthEndpoint": "http://localhost:8080/health",
    "EvaluationTimeOnSeconds": 10,
    "MaximumHistoryEntriesPerEndpoint": 60,
    "StorageMode": "InMemory"
  }
}